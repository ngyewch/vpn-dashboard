{
  "name": "vpn-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "doDev": "vite",
    "doBuild": "cross-env NODE_ENV=production vite build",
    "doPreview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "watch:check": "svelte-check --tsconfig ./tsconfig.app.json --watch",
    "dev": "run-p watch:* doDev",
    "build": "run-s check doBuild",
    "preview": "run-s build doPreview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tsconfig/svelte": "5.0.8",
    "@types/humanize-duration": "3.27.4",
    "@types/node": "24.13.3",
    "cross-env": "10.1.0",
    "npm-run-all2": "9.0.3",
    "sass": "1.102.0",
    "svelte-check": "4.7.5",
    "svelte-preprocess": "6.0.5",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  },
  "dependencies": {
    "@picocss/pico": "2.1.1",
    "humanize-duration": "3.34.0",
    "ky": "2.0.2",
    "pretty-bytes": "7.1.1",
    "svelte": "5.56.8",
    "svelte-toasts": "1.1.2"
  }
}
